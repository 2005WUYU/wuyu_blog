---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="zh-cn">
  <head>
    <BaseHead title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      :root {
        --text-color: #2c3e50;
        --bg-color: #f7f9fc;
        --border-light: rgba(0,0,0,0.08);
        --accent: #66ccff;
        --card-bg: rgba(255, 255, 255, 0.6);
        --glass-border: rgba(255,255,255,0.4);
      }
      html.dark {
        --text-color: #e2e8f0;
        --bg-color: #1a1b26;
        --border-light: rgba(255,255,255,0.08);
        --accent: #88ddff;
        --card-bg: rgba(30,30,46,0.5);
        --glass-border: rgba(255,255,255,0.05);
      }
      body {
        margin: 0;
        font-family: 'Helvetica Neue', Arial, sans-serif;
        color: var(--text-color);
        background-color: var(--bg-color);
        transition: background-color 0.4s ease, color 0.4s ease;
        min-height: 100vh;
      }
      .container {
        max-width: 840px;
        margin: 0 auto;
        padding: 5rem 2rem;
      }
      .page-header {
        margin-bottom: 3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .page-title {
        font-size: 2.2rem;
        font-weight: 300;
        letter-spacing: 2px;
        color: var(--text-color);
        margin: 0;
      }
      .nav-links {
        display: flex;
        gap: 1.8rem;
      }
      .nav-links a {
        text-decoration: none;
        color: var(--text-color);
        opacity: 0.7;
        font-size: 0.95rem;
        transition: opacity 0.3s, color 0.3s;
      }
      .nav-links a:hover {
        opacity: 1;
        color: var(--accent);
      }
      .list-container {
        background: var(--card-bg);
        backdrop-filter: blur(8px);
        border-radius: 16px;
        padding: 0 2rem;
        border: 1px solid var(--border-light);
      }
      .post-item {
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border-light);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: all 0.3s ease;
        position: relative;
      }
      .post-item::before {
        content: '';
        position: absolute;
        left: -1rem;
        top: 0;
        height: 100%;
        width: 3px;
        background: var(--accent);
        transform: scaleY(0);
        transition: transform 0.3s ease;
      }
      .post-item:hover {
        padding-left: 1rem;
      }
      .post-item:hover::before {
        transform: scaleY(0.6);
      }
      .post-item:last-child {
        border-bottom: none;
      }
      .post-meta {
        display: flex;
        gap: 1rem;
        align-items: center;
      }
      .post-date {
        font-size: 0.85rem;
        opacity: 0.5;
        font-family: monospace;
      }
      .post-title {
        color: var(--text-color);
        text-decoration: none;
        font-size: 1.3rem;
        font-weight: 500;
      }
      .post-title:hover {
        color: var(--accent);
      }
      .back-btn {
        margin-bottom: 2rem;
        display: inline-block;
        text-decoration: none;
        color: var(--text-color);
        opacity: 0.6;
        transition: opacity 0.3s;
      }
      .back-btn:hover {
        opacity: 1;
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="/" class="back-btn">← Back to Home</a>
      <div class="page-header">
        <h1 class="page-title">Blog</h1>
        <nav class="nav-links">
          <a href="/essay/">Essay</a>
        </nav>
      </div>

      <div class="list-container">
        {posts.length === 0 ? <p style="padding: 2rem 0; opacity: 0.5;">暂无技术博客...</p> : posts.map((post) => (
          <div class="post-item">
            <a href={`/blog/${post.id}/`} class="post-title">
              {post.data.title}
            </a>
            <div class="post-meta">
              <span class="post-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit'})}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
    <script is:inline>
      const html = document.documentElement;
      if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        html.classList.add('dark');
      }
    </script>
  </body>
</html>
