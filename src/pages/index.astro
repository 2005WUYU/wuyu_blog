---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Miku from '../components/Miku.jsx';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// 抓取所有文章
const allBlogs = await getCollection('blog').catch(() => []);
const allEssays = await getCollection('essay').catch(() => []);

const allPostsRaw = [...allBlogs, ...allEssays];
const allPosts = [...allPostsRaw]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const assetImages = import.meta.glob<ImageMetadata>('../assets/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  import: 'default',
});

const coverPostByImageSrc = new Map<string, { href: string; title: string; collection: string }>();
for (const post of allPostsRaw) {
  const heroImage = 'heroImage' in post.data ? post.data.heroImage : undefined;
  if (heroImage?.src && !coverPostByImageSrc.has(heroImage.src)) {
    coverPostByImageSrc.set(heroImage.src, {
      href: `/${post.collection}/${post.id}/`,
      title: post.data.title,
      collection: post.collection,
    });
  }
}

const galleryItems = Object.entries(assetImages)
  .map(([path, image]) => {
    const fileName = path.split('/').pop() ?? '';
    const linkedPost = coverPostByImageSrc.get(image.src);
    return {
      fileName,
      image,
      linkedPost,
    };
  })
  .sort((a, b) => a.fileName.localeCompare(b.fileName, 'zh-CN'));

// 真实的贡献热力图数据 (最近 60 天)
const postDates = allPostsRaw.map(p => {
  const d = p.data.pubDate;
  // Convert to local YYYY-MM-DD
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
});
const dateCounts: Record<string, number> = {};
postDates.forEach(d => { dateCounts[d] = (dateCounts[d] || 0) + 1; });

const daysForHeatmap = 60;
const heatMap = [];
for (let i = daysForHeatmap - 1; i >= 0; i--) {
  const d = new Date();
  d.setDate(d.getDate() - i);
  const dateStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  heatMap.push({
      date: dateStr,
      count: dateCounts[dateStr] || 0,
      isToday: i === 0
  });
}

const navLinks = [
  { text: 'Blog', href: '/blog/' },
  { text: 'Essay', href: '/essay/' },
  { text: 'Links', href: '/friends/' },
  { text: 'About', href: '/about/' }
];
---

<!doctype html>
<html lang="zh-cn">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      :root {
        --text-color: #2c3e50;
        --bg-color: #f7f9fc;
        --border-light: rgba(0,0,0,0.08);
        --accent: #66ccff; /* 典雅的绿色 */
        --card-bg: rgba(255, 255, 255, 0.6);
        --glass-border: rgba(255,255,255,0.4);
      }
      html.dark {
        --text-color: #e2e8f0;
        --bg-color: #1a1b26; /* 暗夜紫黑 */
        --border-light: rgba(255,255,255,0.08);
        --accent: #88ddff;
        --card-bg: rgba(30,30,46,0.5);
        --glass-border: rgba(255,255,255,0.05);
      }
      body {
        margin: 0;
        font-family: 'Helvetica Neue', Arial, sans-serif;
        color: var(--text-color);
        background-color: var(--bg-color);
        transition: background-color 0.4s ease, color 0.4s ease;
        min-height: 100vh;
      }
      .container {
        max-width: 840px;
        margin: 0 auto;
        padding: 5rem 2rem;
        position: relative;
        z-index: 10;
      }
      
      /* 玻璃拟物面板 */
      .glass-panel {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 2.5rem;
        margin-bottom: 3rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        position: relative;
        overflow: hidden;
      }

      /* 英雄区与导航 */
      .hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }
      .hero-title {
        font-size: 2.2rem;
        line-height: 1.2;
        margin-bottom: 0.5rem;
        font-weight: 300;
        letter-spacing: 2px;
        color: var(--text-color);
      }
      .hero-subtitle {
        color: var(--accent);
        font-size: 1rem;
        margin-bottom: 1.5rem;
        font-weight: 500;
        letter-spacing: 1px;
      }
      .about-text {
        font-size: 0.95rem;
        line-height: 1.7;
        opacity: 0.85;
        max-width: 100%;
        margin-bottom: 2rem;
      }
      .nav-links {
        display: flex;
        gap: 1.8rem;
        flex-wrap: wrap;
      }
      .nav-links a {
        text-decoration: none;
        color: var(--text-color);
        opacity: 0.7;
        font-size: 0.95rem;
        transition: opacity 0.3s, transform 0.3s, color 0.3s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .nav-links a:hover {
        opacity: 1;
        transform: translateY(-2px);
        color: var(--accent);
      }

      /* 主题切换 */
      .theme-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        font-size: 1.5rem;
        padding: 0.5rem;
        border-radius: 50%;
        transition: transform 0.3s, background 0.3s;
      }
      .theme-btn:hover {
        background: var(--border-light);
        transform: scale(1.1);
      }

      /* GitHub绿格子日历 */
      .calendar-section {
        margin-top: 2.5rem;
        border-top: 1px dashed var(--border-light);
        padding-top: 1.5rem;
      }
      .section-title {
        font-size: 0.85rem;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        opacity: 0.5;
        font-weight: 600;
      }
      .calendar-grid {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
      }
      .cal-box {
        width: 14px;
        height: 14px;
        border-radius: 3px;
        background-color: var(--border-light);
        transition: transform 0.2s, background-color 0.3s;
        cursor: pointer;
        position: relative;
      }
      .cal-box:hover {
        transform: scale(1.3);
        z-index: 2;
        box-shadow: 0 0 10px var(--accent);
      }
      /* Real data colors based on count */
      .cal-box[data-count="0"] { background-color: var(--border-light); }
      .cal-box[data-count="1"] { background-color: rgba(102, 204, 255, 0.4); box-shadow: 0 0 5px rgba(102, 204, 255, 0.2); }
      .cal-box[data-count="2"] { background-color: rgba(102, 204, 255, 0.7); box-shadow: 0 0 5px rgba(102, 204, 255, 0.4); }
      .cal-box[data-count="3"] { background-color: rgba(102, 204, 255, 0.9); box-shadow: 0 0 5px rgba(102, 204, 255, 0.6); }

      /* 最近文章 */
      .post-item {
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border-light);
        display: flex;
        align-items: center;
        gap: 1.5rem;
        transition: all 0.3s ease;
        position: relative;
      }
      .post-item::before {
        content: '';
        position: absolute;
        left: -1rem;
        top: 0;
        height: 100%;
        width: 3px;
        background: var(--accent);
        transform: scaleY(0);
        transition: transform 0.3s ease;
      }
      .post-item:hover {
        padding-left: 1rem;
      }
      .post-item:hover::before {
        transform: scaleY(0.6);
      }
      .post-item:last-child {
        border-bottom: none;
      }
      .post-date {
        font-size: 0.85rem;
        opacity: 0.5;
        font-family: monospace;
        min-width: 90px;
      }
      .post-title {
        color: var(--text-color);
        text-decoration: none;
        font-size: 1.15rem;
        font-weight: 500;
        flex: 1;
      }
      .post-title:hover {
        color: var(--accent);
      }
      .post-tag {
        font-size: 0.7rem;
        padding: 3px 8px;
        border-radius: 12px;
        background: var(--border-light);
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.7;
      }

      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.5rem;
        margin-bottom: 4rem;
      }
      .gallery-card {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--border-light);
        height: 260px;
        position: relative;
        background: var(--card-bg);
      }
      .gallery-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.35s ease;
      }
      .gallery-link {
        display: block;
        height: 100%;
      }
      .gallery-link:hover img {
        transform: scale(1.03);
      }
      .cover-badge {
        position: absolute;
        left: 0.8rem;
        bottom: 0.8rem;
        padding: 0.35rem 0.6rem;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.56);
        color: #fff;
        font-size: 0.72rem;
        letter-spacing: 0.3px;
        backdrop-filter: blur(3px);
      }

    </style>
  </head>
  <body>
    <!-- Live2D Miku - Fixed on bottom right usually -->
    <div style="position: fixed; bottom: 0; right: 0; z-index: 100; pointer-events: none;">
      <div style="pointer-events: auto;">
        <Miku client:only="react" />
      </div>
    </div>

    <div class="container">
      <div class="glass-panel">
        <header class="hero">
          <div>
            <h1 class="hero-title">wuyu's Space</h1>
            <div class="hero-subtitle">Code / Society / BME / ACG Life</div>
            <p class="about-text">
              欢迎来到我的 Blog！技术主要方向目前是训推框架，同时也会分享bme课程学习相关与感兴趣的人文社科论题的探讨。
            </p>
            <nav class="nav-links">
              {navLinks.map(link => (
                <a href={link.href}>
                  {link.text}
                </a>
              ))}
            </nav>
          </div>
          <button class="theme-btn" id="theme-toggle" title="切换昼夜模式">
            🌓
          </button>
        </header>

        <div class="calendar-section">
          <div class="section-title">Contribution Activity</div>
          <div class="calendar-grid">
            {heatMap.map((item) => (
              <div 
                class="cal-box" 
                data-count={item.count > 3 ? 3 : item.count} 
                style={item.count >= 4 ? "background-color: var(--accent); box-shadow: 0 0 5px var(--accent);" : ""}
                title={`${item.date}: ${item.count} post(s)`}
              ></div>
            ))}
          </div>
        </div>
      </div>

      <div>
        <div class="section-title" style="margin-left: 1rem;">Recent Articles</div>
        <div style="background: var(--card-bg); backdrop-filter: blur(8px); border-radius: 16px; padding: 0 2rem; border: 1px solid var(--border-light); margin-bottom: 3rem;">
          {allPosts.length === 0 ? <p style="padding: 2rem 0; opacity: 0.5;">暂时没有文章哦...</p> : allPosts.map((post) => (
            <div class="post-item">
              <div class="post-date">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit'})}
              </div>
              <a href={`/${post.collection}/${post.id}/`} class="post-title">
                {post.data.title}
              </a>
              <span class="post-tag">{post.collection}</span>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Art Gallery Preview Section -->
      <div>
        <div class="section-title" style="margin-left: 1rem;">ACG Gallery</div>
        <div class="gallery-grid">
          {galleryItems.map((item) => (
            <div class="gallery-card">
              {item.linkedPost ? (
                <a class="gallery-link" href={item.linkedPost.href} title={`封面图：${item.linkedPost.title}`}>
                  <Image src={item.image} alt={item.fileName} />
                  <span class="cover-badge">{item.linkedPost.collection.toUpperCase()} 封面</span>
                </a>
              ) : (
                <Image src={item.image} alt={item.fileName} />
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      const html = document.documentElement;

      // 检查缓存或系统偏好
      if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        html.classList.add('dark');
      }

      toggle.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
