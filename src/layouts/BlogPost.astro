---
import { Image } from 'astro:assets';
import { ViewTransitions } from 'astro:transitions';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Miku from '../components/Miku.jsx';
import 'katex/dist/katex.min.css';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh-cn">
  <head>
    <ViewTransitions />
    <BaseHead title={title} description={description || title} />

    <style>
      :root {
        --text-color: #2c3e50;
        --bg-color: #f7f9fc;
        --border-light: rgba(0,0,0,0.08);
        --accent: #66ccff;
        --card-bg: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255,255,255,0.4);
      }
      html.dark {
        --text-color: #e2e8f0;
        --bg-color: #1a1b26;
        --border-light: rgba(255,255,255,0.08);
        --accent: #88ddff;
        --card-bg: rgba(30,30,46,0.5);
        --glass-border: rgba(255,255,255,0.05);
      }
      body {
        margin: 0;
        font-family: 'Helvetica Neue', Arial, sans-serif;
        color: var(--text-color);
        background-color: var(--bg-color);
        transition: background-color 0.4s ease, color 0.4s ease;
        min-height: 100vh;
      }
      .container {
        max-width: 880px;
        margin: 0 auto;
        padding: 4rem 2rem 8rem 2rem;
      }
      .back-btn {
        margin-bottom: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--text-color);
        opacity: 0.6;
        transition: opacity 0.3s;
      }
      .back-btn:hover {
        opacity: 1;
        color: var(--accent);
      }
      
      .glass-panel {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 3rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
      }

      .hero-image {
        width: calc(100% + 6rem);
        margin-left: -3rem;
        margin-top: -3rem;
        margin-bottom: 2rem;
      }
      .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 16px 16px 0 0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      }

      .post-header {
        margin-bottom: 2rem;
        text-align: center;
      }
      .post-title {
        font-size: 2.2rem;
        font-weight: 500;
        letter-spacing: 1px;
        color: var(--text-color);
        margin: 0 0 1rem 0;
        line-height: 1.3;
      }
      .post-meta {
        font-size: 0.9rem;
        opacity: 0.6;
        font-family: monospace;
      }
      .post-content {
        line-height: 1.8;
        font-size: 1.05rem;
        color: var(--text-color);
      }
      
      /* Markdown elements styling inside post-content */
      .post-content h2, .post-content h3, .post-content h4 {
        color: var(--accent);
        margin-top: 2rem;
        margin-bottom: 1rem;
        font-weight: 500;
      }
      .post-content a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px dashed var(--accent);
        transition: opacity 0.3s;
      }
      .post-content a:hover {
        opacity: 0.7;
      }
      .post-content img {
        max-width: 100%;
        border-radius: 8px;
        margin: 1.5rem 0;
      }
      .post-content pre {
        padding: 1.2rem;
        border-radius: 8px;
        overflow-x: auto;
        background: #1a1b26 !important;
        border: 1px solid var(--glass-border);
        font-family: 'Fira Code', monospace;
        font-size: 0.9rem;
      }
      .post-content code {
        font-family: 'Fira Code', monospace;
      }
      .post-content blockquote {
        border-left: 4px solid var(--accent);
        margin: 1.5rem 0;
        padding: 0.5rem 0 0.5rem 1rem;
        background: var(--border-light);
        border-radius: 0 8px 8px 0;
        opacity: 0.8;
      }
      
      hr {
        border: none;
        border-top: 1px dashed var(--border-light);
        margin: 2rem 0;
      }
    </style>
  </head>

  <body>
    <!-- Live2D Miku -->
    <div style="position: fixed; bottom: 0; right: 0; z-index: 100; pointer-events: none;">
      <div style="pointer-events: auto;">
        <Miku client:only="react" />
      </div>
    </div>

    <main class="container">
      <a href="javascript:history.back()" class="back-btn">← Back</a>
      
      <article class="glass-panel">
        {heroImage && (
          <div class="hero-image">
            <Image width={1020} height={510} src={heroImage} alt="" />
          </div>
        )}
        
        <div class="post-header">
          <h1 class="post-title">{title}</h1>
          <div class="post-meta">
            <FormattedDate date={pubDate} />
            {updatedDate && (
              <span> | Updated: <FormattedDate date={updatedDate} /></span>
            )}
          </div>
        </div>
        
        <hr />
        
        <div class="post-content">
          <slot />
        </div>
      </article>
    </main>

    <script is:inline>
      const html = document.documentElement;
      if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        html.classList.add('dark');
      }
    </script>
  </body>
</html>
